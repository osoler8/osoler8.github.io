<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>L'aventura de les mesures: longitud, massa i capacitat</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome CDN per a icones segures -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Tipografia Inter de Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    
    /* Evitar barra de desplaçament lletja als botons horitzontals */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Animacions visuals suaus */
    @keyframes hop {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px) scale(1.08); }
    }
    .animate-hop {
      animation: hop 0.4s ease-in-out;
    }

    @keyframes pulseGold {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(245, 158, 11, 0)); }
      50% { transform: scale(1.04); filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.4)); }
    }
    .animate-gold {
      animation: pulseGold 2.2s infinite ease-in-out;
    }

    /* Estils de les pestanyes actives */
    .tab-btn.active {
      background-color: #0284c7;
      color: #ffffff;
      box-shadow: 0 4px 6px -1px rgba(2, 132, 199, 0.25);
    }
    .tab-btn-boss.active {
      background-color: #b45309;
      color: #ffffff;
      box-shadow: 0 4px 8px -1px rgba(180, 83, 9, 0.35);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen antialiased selection:bg-sky-200">

  <!-- ================= CANVAS NADIU PER AL CONFETI (SENSE DEPENDÈNCIES EXTERNES) ================= -->
  <canvas id="confettiCanvas" class="fixed inset-0 pointer-events-none z-50 w-full h-full"></canvas>

  <!-- ================= CAPÇALERA FIXA REAL (NETA I BEN MESURADA) ================= -->
  <header class="fixed top-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-slate-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-3 sm:px-5 py-2.5">
      
      <!-- Fila superior: logotip i estat del jugador -->
      <div class="flex items-center justify-between gap-2 mb-2">
        
        <!-- Logotip -->
        <div class="flex items-center gap-2.5 cursor-pointer shrink-0" onclick="switchSection('lab')">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white text-xl shadow-md">
            <i class="fa-solid fa-ruler-combined"></i>
          </div>
          <div>
            <h1 class="text-base sm:text-lg font-black tracking-tight text-sky-950 leading-none">L'aventura de les mesures</h1>
            <p class="text-[11px] sm:text-xs text-sky-600 font-bold hidden sm:block">Longitud, massa i capacitat</p>
          </div>
        </div>

        <!-- Indicador de nivell, avatar i punts XP -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
          <!-- Botó avatar -->
          <button onclick="openAvatarModal()" class="flex items-center gap-1.5 bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-full px-2.5 py-1 transition" title="Canviar perfil">
            <span id="playerAvatar" class="text-lg sm:text-xl">🧭</span>
            <span id="playerName" class="hidden md:inline font-bold text-amber-950 text-xs max-w-[100px] truncate">Explorador/a</span>
          </button>

          <!-- Marcador XP i rang -->
          <div class="bg-sky-50 border border-sky-200 rounded-2xl px-2.5 sm:px-3 py-1 flex items-center gap-2">
            <div class="flex flex-col">
              <div class="flex justify-between items-center gap-2 text-[10px] sm:text-xs font-black text-sky-900">
                <span id="playerRankName" class="truncate max-w-[110px] sm:max-w-[150px]">Explorador/a novell</span>
                <span class="text-sky-600 font-bold"><span id="playerXpVal">0</span> XP</span>
              </div>
              <div class="w-16 sm:w-24 bg-sky-200 rounded-full h-1.5 mt-0.5 overflow-hidden">
                <div id="playerXpBar" class="bg-gradient-to-r from-amber-400 to-emerald-500 h-full rounded-full transition-all duration-300" style="width: 5%;"></div>
              </div>
            </div>
            
            <!-- Botó per veure medalles -->
            <button onclick="openBadgesModal()" class="text-amber-500 hover:text-amber-600 text-base sm:text-lg ml-0.5" title="Medalles aconseguides">
              <i class="fa-solid fa-award"></i>
            </button>
          </div>

          <!-- Reiniciar progrés -->
          <button onclick="resetGameProgress()" class="p-1.5 text-slate-400 hover:text-rose-500 rounded-xl transition" title="Reiniciar punts">
            <i class="fa-solid fa-rotate-right text-xs"></i>
          </button>
        </div>
      </div>

      <!-- Fila inferior: 6 pestanyes de navegació fixa -->
      <nav class="flex overflow-x-auto no-scrollbar gap-1.5 pt-1 text-xs sm:text-sm font-bold">
        <button id="nav-lab" onclick="switchSection('lab')" class="tab-btn active px-3 py-1.5 rounded-xl whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center gap-1.5">
          <i class="fa-solid fa-flask-vial text-sky-500"></i>
          <span>El laboratori de les mesures</span>
        </button>

        <button id="nav-game1" onclick="switchSection('game1')" class="tab-btn px-3 py-1.5 rounded-xl whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center gap-1.5">
          <i class="fa-solid fa-circle-question text-emerald-500"></i>
          <span>1. Tria la unitat</span>
        </button>

        <button id="nav-game2" onclick="switchSection('game2')" class="tab-btn px-3 py-1.5 rounded-xl whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center gap-1.5">
          <i class="fa-solid fa-shuffle text-indigo-500"></i>
          <span>2. Aparellar</span>
        </button>

        <button id="nav-game3" onclick="switchSection('game3')" class="tab-btn px-3 py-1.5 rounded-xl whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center gap-1.5">
          <i class="fa-solid fa-scale-balanced text-purple-500"></i>
          <span>3. Balança i conversió</span>
        </button>

        <button id="nav-game4" onclick="switchSection('game4')" class="tab-btn px-3 py-1.5 rounded-xl whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center gap-1.5">
          <i class="fa-solid fa-stopwatch-20 text-rose-500"></i>
          <span>4. Contrarellotge</span>
        </button>

        <!-- Pestanya 5: Boss final destacada -->
        <button id="nav-game5" onclick="switchSection('game5')" class="tab-btn-boss px-3.5 py-1.5 rounded-xl whitespace-nowrap bg-amber-100 text-amber-900 border border-amber-300 hover:bg-amber-200 transition flex items-center gap-1.5 ml-auto font-black shadow-sm">
          <i class="fa-solid fa-crown text-amber-500"></i>
          <span>5. El gran repte final 👑</span>
        </button>
      </nav>

    </div>
  </header>

  <!-- ================= CONTENIDOR PRINCIPAL (AMB PADDING TOP SUFICIENT) ================= -->
  <main class="max-w-6xl mx-auto px-4 pt-36 sm:pt-40 md:pt-44 pb-16">

    <!-- ================= PESTANYA 0: EL LABORATORI DE LES MESURES ================= -->
    <section id="section-lab" class="view-panel space-y-6">
      
      <!-- Targeta de benvinguda al laboratori -->
      <div class="bg-gradient-to-r from-sky-500 via-indigo-500 to-emerald-500 rounded-3xl p-6 sm:p-8 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
          <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-bold tracking-wider mb-2">Comença aquí la teva aventura</span>
          <h2 class="text-2xl sm:text-4xl font-black mb-2">El laboratori de les mesures</h2>
          <p class="text-sky-50 text-xs sm:text-base leading-relaxed">
            Per mesurar el nostre entorn necessitem unitats precises i clares. Si mesurem el gruix d'una moneda fem servir <strong>mil·límetres (mm)</strong>; per una pissarra fem servir <strong>metres (m)</strong>; per saber el pes d'un paquet de farina fem servir <strong>quilograms (kg)</strong>; i per l'aigua d'un tetrabric, <strong>litres (l)</strong>!
          </p>
        </div>
        <div class="absolute -right-4 -bottom-6 text-white/15 text-8xl sm:text-9xl pointer-events-none">
          <i class="fa-solid fa-flask-vial"></i>
        </div>
      </div>

      <!-- Selector de magnitud al laboratori -->
      <div class="flex justify-center gap-2 sm:gap-4">
        <button id="btn-mag-longitud" onclick="setLabTab('longitud')" class="px-4 sm:px-6 py-2.5 rounded-2xl font-black text-sm sm:text-base bg-sky-500 text-white shadow-md transition flex items-center gap-2">
          <i class="fa-solid fa-ruler"></i> Longitud
        </button>
        <button id="btn-mag-massa" onclick="setLabTab('massa')" class="px-4 sm:px-6 py-2.5 rounded-2xl font-black text-sm sm:text-base bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition flex items-center gap-2">
          <i class="fa-solid fa-weight-hanging"></i> Massa
        </button>
        <button id="btn-mag-capacitat" onclick="setLabTab('capacitat')" class="px-4 sm:px-6 py-2.5 rounded-2xl font-black text-sm sm:text-base bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition flex items-center gap-2">
          <i class="fa-solid fa-glass-water"></i> Capacitat
        </button>
      </div>

      <!-- Targetes explicatives amb objectes reals de l'escola -->
      <div id="labCardsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

      <!-- Eina interactiva: L'escala màgica de la granota -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-300 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-5">
          <div>
            <h3 class="text-xl sm:text-2xl font-black text-emerald-950 flex items-center gap-2">
              <span>🐸</span> L'escala màgica de la granota: salts de 10
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm mt-0.5">Comprova com canvia una quantitat en saltar d'una unitat a una altra:</p>
          </div>
          <div class="flex flex-wrap gap-2 text-xs font-bold">
            <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-xl">Baixar escala: multiplica (×10)</span>
            <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-xl">Pujar escala: divideix (÷10)</span>
          </div>
        </div>

        <div class="bg-emerald-50/70 p-5 rounded-2xl border border-emerald-200">
          <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-center">
            
            <div>
              <label class="text-[11px] font-bold text-slate-500 block mb-1">Quantitat:</label>
              <input type="number" id="frogValueInput" value="1" min="0" step="any" class="w-24 text-center font-black text-lg px-2 py-1.5 rounded-xl border-2 border-emerald-400 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>

            <div>
              <label class="text-[11px] font-bold text-slate-500 block mb-1">Unitat d'origen:</label>
              <select id="frogFromSelect" class="font-bold text-sm px-3 py-2 rounded-xl border-2 border-emerald-400 bg-white text-emerald-950 shadow-sm"></select>
            </div>

            <div class="text-xl text-emerald-600 font-black self-end pb-2">➔</div>

            <div>
              <label class="text-[11px] font-bold text-slate-500 block mb-1">Unitat de destí:</label>
              <select id="frogToSelect" class="font-bold text-sm px-3 py-2 rounded-xl border-2 border-emerald-400 bg-white text-emerald-950 shadow-sm"></select>
            </div>

            <div class="self-end pb-1">
              <button onclick="calculateFrogJump()" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-black rounded-xl shadow-md transition active:scale-95 flex items-center gap-2">
                <span id="frogAnimEmoji" class="text-lg inline-block">🐸</span> Fes el salt!
              </button>
            </div>
          </div>

          <!-- Resultat del salt -->
          <div id="frogResultBox" class="mt-4 bg-white p-4 rounded-xl border border-emerald-200 text-center hidden">
            <p id="frogResultTitle" class="text-emerald-950 font-black text-lg mb-0.5"></p>
            <p id="frogResultExplanation" class="text-slate-600 text-xs sm:text-sm"></p>
          </div>
        </div>
      </div>

    </section>

    <!-- ================= PESTANYA 1: TRIA LA UNITAT ================= -->
    <section id="section-game1" class="view-panel hidden space-y-6">
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-sky-300 shadow-sm text-center max-w-3xl mx-auto">
        <div class="flex justify-between items-center mb-4">
          <span class="px-3 py-1 bg-sky-100 text-sky-800 font-extrabold rounded-full text-xs">Activitat 1 · Estimació quotidiana</span>
          <span class="text-amber-500 font-bold text-sm"><i class="fa-solid fa-star"></i> +20 XP</span>
        </div>

        <h2 class="text-xl sm:text-2xl font-black text-sky-950 mb-1">Quina és la unitat més adequada?</h2>
        <p class="text-slate-600 text-xs sm:text-sm mb-6">Pensa en la mesura real d'aquest element i tria la millor unitat per indicar-la.</p>

        <div class="bg-gradient-to-b from-sky-50 to-indigo-50/40 p-6 rounded-3xl border border-sky-200 mb-6">
          <div id="g1Icon" class="text-6xl sm:text-7xl mb-2 transition transform hover:scale-110">✏️</div>
          <h3 id="g1Title" class="text-xl sm:text-2xl font-bold text-slate-800 mb-1">Un llapis per pintar</h3>
          <p id="g1Sub" class="text-sky-700 text-xs font-bold">Magnitud: longitud</p>
        </div>

        <div id="g1OptionsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6"></div>

        <div id="g1Feedback" class="hidden p-4 rounded-2xl text-center font-bold text-sm sm:text-base"></div>

        <button id="g1NextBtn" onclick="nextGame1Question()" class="hidden mt-4 mx-auto px-6 py-2.5 bg-sky-500 hover:bg-sky-600 text-white rounded-2xl font-bold shadow-md transition active:scale-95 flex items-center gap-2">
          Següent element <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </section>

    <!-- ================= PESTANYA 2: APARELLAR ================= -->
    <section id="section-game2" class="view-panel hidden space-y-6">
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-indigo-300 shadow-sm max-w-4xl mx-auto">
        <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
          <div>
            <span class="px-3 py-1 bg-indigo-100 text-indigo-900 font-extrabold rounded-full text-xs">Activitat 2 · Associació d'entorn</span>
            <h2 class="text-xl sm:text-2xl font-black text-indigo-950 mt-1">Aparella cada objecte amb la seva mesura real</h2>
          </div>
          <div>
            <span id="g2CounterBadge" class="px-3.5 py-1.5 bg-indigo-500 text-white font-black rounded-2xl text-xs sm:text-sm">Parella 0 / 4</span>
          </div>
        </div>

        <p class="text-slate-600 text-xs sm:text-sm mb-6">Clica sobre un objecte (esquerra) i després sobre la mesura aproximada que li correspon (dreta).</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2.5">
            <h4 class="font-bold text-slate-700 text-xs uppercase tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-cube text-indigo-500"></i> Objectes quotidians:
            </h4>
            <div id="g2ObjectsCol" class="space-y-2.5"></div>
          </div>

          <div class="space-y-2.5">
            <h4 class="font-bold text-slate-700 text-xs uppercase tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-ruler-combined text-indigo-500"></i> Mesures raonables:
            </h4>
            <div id="g2ValuesCol" class="space-y-2.5"></div>
          </div>
        </div>

        <div id="g2SuccessMsg" class="hidden mt-6 p-4 bg-emerald-100 text-emerald-900 rounded-2xl text-center font-bold">
          🎉 Excel·lent! Has relacionat correctament totes les mesures d'aquesta ronda! (+60 XP)
          <div class="mt-3">
            <button onclick="initGame2()" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-bold shadow">
              Nova ronda d'objectes <i class="fa-solid fa-rotate-right ml-1"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PESTANYA 3: BALANÇA I CONVERSIÓ ================= -->
    <section id="section-game3" class="view-panel hidden space-y-6">
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-purple-300 shadow-sm text-center max-w-3xl mx-auto">
        <div class="flex justify-between items-center mb-4">
          <span class="px-3 py-1 bg-purple-100 text-purple-900 font-extrabold rounded-full text-xs">Activitat 3 · Canvis i equivalències</span>
          <span class="text-amber-500 font-bold text-sm"><i class="fa-solid fa-trophy"></i> +30 XP</span>
        </div>

        <h2 class="text-xl sm:text-2xl font-black text-purple-950 mb-1">Equilibra la balança!</h2>
        <p class="text-slate-600 text-xs sm:text-sm mb-6">Tria el valor exacte perquè els dos costats tinguin el mateix pes o mesura.</p>

        <div class="bg-gradient-to-b from-purple-50 to-indigo-50 p-6 rounded-3xl border border-purple-200 mb-6">
          <!-- Dibuix visual de la balança -->
          <div class="w-44 h-2.5 bg-purple-400 mx-auto rounded-full mb-6 relative">
            <div class="w-3.5 h-7 bg-purple-600 mx-auto -mt-5 rounded-md"></div>
          </div>

          <div class="grid grid-cols-2 gap-4 items-center">
            <div class="bg-white p-4 rounded-2xl border-2 border-purple-300 shadow-sm">
              <span class="text-[10px] uppercase font-black text-purple-500 block">Plat esquerre</span>
              <div id="g3LeftVal" class="text-2xl sm:text-3xl font-black text-slate-800 my-1">2 m</div>
              <span class="text-xs text-slate-400">Quantitat de referència</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border-2 border-dashed border-purple-400 shadow-sm">
              <span class="text-[10px] uppercase font-black text-purple-500 block">Plat dret</span>
              <div id="g3RightTarget" class="text-2xl sm:text-3xl font-black text-purple-600 my-1">? cm</div>
              <span class="text-xs text-slate-400">Quin és el seu equivalent?</span>
            </div>
          </div>
        </div>

        <div id="g3OptionsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4"></div>

        <div id="g3Feedback" class="hidden p-4 rounded-2xl text-center font-bold text-sm sm:text-base"></div>

        <button id="g3NextBtn" onclick="nextGame3Question()" class="hidden mt-4 mx-auto px-6 py-2.5 bg-purple-500 hover:bg-purple-600 text-white rounded-2xl font-bold shadow-md transition active:scale-95 flex items-center gap-2">
          Següent balança <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </section>

    <!-- ================= PESTANYA 4: CONTRARELLOTGE ================= -->
    <section id="section-game4" class="view-panel hidden space-y-6">
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-rose-300 shadow-sm max-w-3xl mx-auto">
        
        <!-- Pantalla prèvia -->
        <div id="g4StartScreen" class="text-center py-6">
          <div class="w-16 h-16 bg-rose-100 text-rose-500 text-3xl rounded-3xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-stopwatch-20"></i>
          </div>
          <span class="px-3 py-1 bg-rose-100 text-rose-800 font-extrabold rounded-full text-xs inline-block mb-2">Activitat 4 · Agilitat mental</span>
          <h2 class="text-2xl sm:text-3xl font-black text-rose-950 mb-2">Contrarellotge de 45 segons</h2>
          <p class="text-slate-600 max-w-md mx-auto mb-6 text-xs sm:text-sm">
            Posa a prova la teva rapidesa. Tens 45 segons per contestar tantes preguntes com puguis. Cada encert et donarà <strong>+25 XP</strong>!
          </p>
          <button onclick="startSpeedGame()" class="px-8 py-3 bg-rose-500 hover:bg-rose-600 text-white font-black text-base rounded-2xl shadow-md transition active:scale-95">
            Comença el repte! ⏱️
          </button>
        </div>

        <!-- Pantalla de joc actiu -->
        <div id="g4ActiveScreen" class="hidden">
          <div class="flex justify-between items-center mb-3">
            <div class="flex items-center gap-2">
              <span class="text-xl">⏱️</span>
              <span id="g4TimerText" class="text-2xl font-black text-rose-600">45s</span>
            </div>
            <div class="text-sm font-bold text-slate-500">
              Encerts: <span id="g4ScoreText" class="text-emerald-600 font-black text-lg">0</span>
            </div>
          </div>

          <div class="w-full bg-slate-100 rounded-full h-2.5 mb-6 overflow-hidden">
            <div id="g4TimerBar" class="bg-rose-500 h-full w-full transition-all duration-1000 linear"></div>
          </div>

          <div class="bg-rose-50/60 p-6 rounded-2xl border border-rose-200 mb-6 text-center">
            <span id="g4CategoryBadge" class="px-3 py-1 bg-white text-rose-700 text-xs font-bold rounded-full shadow-sm mb-2 inline-block">Longitud</span>
            <h3 id="g4QuestionPrompt" class="text-lg sm:text-xl font-bold text-slate-800 my-2">Quants metres té 1 quilòmetre?</h3>
          </div>

          <div id="g4AnswersGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
        </div>

        <!-- Pantalla final -->
        <div id="g4EndScreen" class="hidden text-center py-6">
