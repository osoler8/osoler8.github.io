        interactive: `
          <div class="flex items-center justify-center gap-3 text-lg sm:text-xl font-black text-amber-950">
            <span class="bg-white px-3 py-1 rounded-xl shadow-sm">4.500 mm</span>
            <span class="text-amber-600 text-2xl font-black">¿ ?</span>
            <span class="bg-white px-3 py-1 rounded-xl shadow-sm">4,5 m</span>
          </div>
        `,
        options: ["4.500 mm = 4,5 m", "4.500 mm > 4,5 m", "4.500 mm < 4,5 m"],
        answer: "4.500 mm = 4,5 m",
        reason: "1 metre té 1.000 mm. Multiplicant 4,5 m × 1.000 obtenim 4.500 mm: són exactament iguals (=)!"
      },
      {
        type: "Sèrie ordenada de masses",
        icon: "⚖️",
        title: "Quina d'aquestes llistes de pesos està ben ordenada de menor a major?",
        interactive: `
          <div class="text-xs sm:text-sm font-bold text-slate-700 bg-white p-2.5 rounded-xl border border-amber-200">
            Mesures: <strong>0,75 kg</strong> | <strong>800 g</strong> | <strong>1,2 kg</strong> | <strong>500 g</strong>
          </div>
        `,
        options: [
          "500 g < 0,75 kg < 800 g < 1,2 kg",
          "0,75 kg < 500 g < 800 g < 1,2 kg",
          "500 g < 800 g < 0,75 kg < 1,2 kg",
          "1,2 kg < 800 g < 0,75 kg < 500 g"
        ],
        answer: "500 g < 0,75 kg < 800 g < 1,2 kg",
        reason: "Passat tot a grams: 500 g < 750 g (0,75 kg) < 800 g < 1.200 g (1,2 kg)."
      }
    ];

    let g5Index = 0;

    function initGame5() {
      g5Index = 0;
      loadGame5Item();
    }

    function loadGame5Item() {
      const item = G5_CHALLENGES[g5Index % G5_CHALLENGES.length];
      document.getElementById('g5TypeBadge').textContent = item.type;
      document.getElementById('g5ProgressBadge').textContent = `Repte ${(g5Index % G5_CHALLENGES.length) + 1} / ${G5_CHALLENGES.length}`;
      document.getElementById('g5PromptIcon').textContent = item.icon;
      document.getElementById('g5Title').textContent = item.title;
      document.getElementById('g5InteractiveBox').innerHTML = item.interactive;

      const feedback = document.getElementById('g5Feedback');
      feedback.className = "hidden p-4 rounded-2xl text-center font-bold text-xs sm:text-sm";
      feedback.textContent = "";

      document.getElementById('g5NextBtn').classList.add('hidden');

      const grid = document.getElementById('g5OptionsGrid');
      grid.innerHTML = '';

      item.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.textContent = opt;
        btn.className = "py-3 sm:py-4 px-3 rounded-2xl bg-white hover:bg-amber-50 border-2 border-amber-300 font-extrabold text-sm sm:text-base text-slate-800 shadow-sm transition active:scale-95";
        btn.onclick = () => checkGame5Choice(opt, btn, item);
        grid.appendChild(btn);
      });
    }

    function checkGame5Choice(selected, btnElem, item) {
      document.querySelectorAll('#g5OptionsGrid button').forEach(b => b.disabled = true);
      const feedback = document.getElementById('g5Feedback');
      feedback.classList.remove('hidden');

      if (selected === item.answer) {
        NativeAudio.playSuccess();
        NativeConfetti.launch();
        btnElem.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600');
        feedback.className = "p-4 rounded-2xl text-center font-bold text-xs sm:text-sm bg-emerald-100 text-emerald-950 border border-emerald-300";
        feedback.innerHTML = `👑 <strong>Fantàstic!</strong> Resposta impecable.<br><span class="text-xs font-medium">${item.reason}</span>`;
        addPlayerXp(50);
        player.stats.game5Correct++;
        evaluateBadges();
      } else {
        NativeAudio.playError();
        btnElem.classList.add('bg-rose-500', 'text-white', 'border-rose-600');
        feedback.className = "p-4 rounded-2xl text-center font-bold text-xs sm:text-sm bg-rose-100 text-rose-950 border border-rose-300";
        feedback.innerHTML = `❌ <strong>Gairebé ho tens!</strong> La solució correcta era: <strong>${item.answer}</strong>.<br><span class="text-xs font-medium">${item.reason}</span>`;
      }

      document.getElementById('g5NextBtn').classList.remove('hidden');
    }

    function nextGame5Question() {
      g5Index++;
      loadGame5Item();
    }

    /* -------------------------------------------------------------
       10. CANVI DE PESTANYES I FINESTRES MODALS
    ------------------------------------------------------------- */
    function switchSection(secKey) {
      document.querySelectorAll('.view-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.tab-btn, .tab-btn-boss').forEach(b => b.classList.remove('active'));

      const panel = document.getElementById(`section-${secKey}`);
      if (panel) panel.classList.remove('hidden');

      const navBtn = document.getElementById(`nav-${secKey}`);
      if (navBtn) navBtn.classList.add('active');

      if (secKey === 'game1') initGame1();
      if (secKey === 'game2') initGame2();
      if (secKey === 'game3') initGame3();
      if (secKey === 'game4') {
        document.getElementById('g4StartScreen').classList.remove('hidden');
        document.getElementById('g4ActiveScreen').classList.add('hidden');
        document.getElementById('g4EndScreen').classList.add('hidden');
      }
      if (secKey === 'game5') initGame5();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openBadgesModal() {
      const grid = document.getElementById('badgesGrid');
      grid.innerHTML = '';

      BADGES.forEach(b => {
        const unlocked = player.badges.includes(b.id);
        const card = document.createElement('div');
        card.className = `p-3 rounded-2xl border text-center transition ${unlocked ? 'bg-amber-50 border-amber-300' : 'bg-slate-100 border-slate-200 opacity-40 grayscale'}`;
        card.innerHTML = `
          <div class="text-2xl mb-1">${b.icon}</div>
          <h4 class="font-bold text-slate-800 text-xs mb-0.5">${b.name}</h4>
          <p class="text-[10px] text-slate-500">${b.desc}</p>
          <span class="mt-2 inline-block text-[9px] font-black uppercase px-2 py-0.5 rounded-full ${unlocked ? 'bg-emerald-200 text-emerald-800' : 'bg-slate-200 text-slate-500'}">
            ${unlocked ? 'Aconseguida' : 'Per desbloquejar'}
          </span>
        `;
        grid.appendChild(card);
      });

      document.getElementById('badgesModal').classList.remove('hidden');
    }

    function closeBadgesModal() {
      document.getElementById('badgesModal').classList.add('hidden');
    }

    function openAvatarModal() {
      document.getElementById('avatarInputName').value = player.name;
      document.getElementById('avatarModal').classList.remove('hidden');
    }

    function closeAvatarModal() {
      document.getElementById('avatarModal').classList.add('hidden');
    }

    let chosenAvatar = "🧭";
    function setAvatarEmoji(emoji) {
      chosenAvatar = emoji;
      document.querySelectorAll('.avatar-pick').forEach(btn => {
        const active = btn.textContent.trim() === emoji;
        btn.classList.toggle('border-sky-500', active);
        btn.classList.toggle('bg-sky-100', active);
      });
    }

    function savePlayerProfile() {
      const name = document.getElementById('avatarInputName').value.trim();
      if (name) player.name = name;
      player.avatar = chosenAvatar;
      saveGameData();
      refreshPlayerUI();
      closeAvatarModal();
      showModalNotice("Perfil guardat", `Tot a punt, ${player.name}!`);
    }

    function showModalNotice(title, desc) {
      document.getElementById('noticeTitle').textContent = title;
      document.getElementById('noticeDesc').textContent = desc;
      document.getElementById('noticeModal').classList.remove('hidden');
    }

    function closeNoticeModal() {
      document.getElementById('noticeModal').classList.add('hidden');
    }

    /* -------------------------------------------------------------
       11. ARRENCADA SEGURA (DOM CONTENT LOADED)
    ------------------------------------------------------------- */
    document.addEventListener('DOMContentLoaded', () => {
      NativeConfetti.init();
      loadGameData();
      setLabTab('longitud');
      initGame1();
    });
  </script>
</body>
</html>
