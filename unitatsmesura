  <!-- ================= CODI JAVASCRIPT ROBUST I ENCAPSULAT ================= -->
  <script>
    /* -------------------------------------------------------------
       1. GENERADOR DE SONS NADIUS AMB WEB AUDIO API
    ------------------------------------------------------------- */
    const NativeAudio = {
      ctx: null,
      getAudioContext() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            this.ctx = new AudioContext();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
        return this.ctx;
      },
      playSuccess() {
        try {
          const ctx = this.getAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(523.25, now);       // Do
          osc.frequency.setValueAtTime(659.25, now + 0.08); // Mi
          osc.frequency.setValueAtTime(783.99, now + 0.16); // Sol
          osc.frequency.setValueAtTime(1046.50, now + 0.24); // Do agut
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.42);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.42);
        } catch (e) {
          console.warn("Àudio no disponible", e);
        }
      },
      playError() {
        try {
          const ctx = this.getAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(220, now);
          osc.frequency.linearRampToValueAtTime(130, now + 0.22);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.25);
        } catch (e) {
          console.warn("Àudio no disponible", e);
        }
      },
      playLevelUp() {
        try {
          const ctx = this.getAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;
          const notes = [440, 554, 659, 880, 1108];
          notes.forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + (idx * 0.08));
            gain.gain.setValueAtTime(0.16, now + (idx * 0.08));
            gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.08) + 0.24);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + (idx * 0.08));
            osc.stop(now + (idx * 0.08) + 0.24);
          });
        } catch (e) {
          console.warn("Àudio no disponible", e);
        }
      },
      playHop() {
        try {
          const ctx = this.getAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(320, now);
          osc.frequency.exponentialRampToValueAtTime(680, now + 0.12);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.12);
        } catch (e) {
          console.warn("Àudio no disponible", e);
        }
      }
    };

    /* -------------------------------------------------------------
       2. MOTOR NADIU DE CONFETI EN CANVAS (SENSE SCRIPTS EXTERNS)
    ------------------------------------------------------------- */
    const NativeConfetti = {
      canvas: null,
      ctx: null,
      particles: [],
      animationId: null,
      init() {
        this.canvas = document.getElementById('confettiCanvas');
        if (this.canvas) {
          this.ctx = this.canvas.getContext('2d');
          this.resize();
          window.addEventListener('resize', () => this.resize());
        }
      },
      resize() {
        if (!this.canvas) return;
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      },
      launch() {
        if (!this.canvas || !this.ctx) this.init();
        const colors = ['#f59e0b', '#10b981', '#0ea5e9', '#ec4899', '#8b5cf6', '#eab308'];
        const count = 75;
        for (let i = 0; i < count; i++) {
          this.particles.push({
            x: this.canvas.width * (0.3 + Math.random() * 0.4),
            y: this.canvas.height * 0.6,
            w: 8 + Math.random() * 6,
            h: 6 + Math.random() * 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            vx: (Math.random() - 0.5) * 16,
            vy: -10 - Math.random() * 12,
            gravity: 0.35,
            rotation: Math.random() * 360,
            rotSpeed: (Math.random() - 0.5) * 8,
            life: 90
          });
        }
        if (!this.animationId) {
          this.update();
        }
      },
      update() {
        if (!this.ctx || !this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.rotation += p.rotSpeed;
          p.life--;

          this.ctx.save();
          this.ctx.translate(p.x, p.y);
          this.ctx.rotate((p.rotation * Math.PI) / 180);
          this.ctx.fillStyle = p.color;
          this.ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          this.ctx.restore();

          if (p.life <= 0 || p.y > this.canvas.height) {
            this.particles.splice(i, 1);
          }
        }
        if (this.particles.length > 0) {
          this.animationId = requestAnimationFrame(() => this.update());
        } else {
          this.animationId = null;
        }
      }
    };

    /* -------------------------------------------------------------
       3. SISTEMA DE GAMIFICACIÓ, RANGS I MEDALLES
    ------------------------------------------------------------- */
    const RANKS = [
      { name: "Explorador/a novell", minXp: 0, maxXp: 180 },
      { name: "Cadet del regle", minXp: 180, maxXp: 420 },
      { name: "Especialista en pesos", minXp: 420, maxXp: 800 },
      { name: "Mestre/a suprem/a de les mesures 👑", minXp: 800, maxXp: 1800 }
    ];

    const BADGES = [
      { id: 'first_step', name: 'Primer pas', desc: 'Aconsegueix els teus primers 20 XP', icon: '🌱' },
      { id: 'length_hawk', name: 'Ull de falcó', desc: 'Supera 5 preguntes d\'estimació de longitud', icon: '📏' },
      { id: 'balance_gold', name: 'Balança d\'or', desc: 'Resol 4 equilibris a la balança', icon: '⚖️' },
      { id: 'water_drop', name: 'Gota màgica', desc: 'Supera dues rondes d\'aparellar mesures', icon: '💧' },
      { id: 'speed_lightning', name: 'Llamp del saber', desc: 'Fes més de 4 encerts al contrarellotge', icon: '⚡' },
      { id: 'frog_master', name: 'Salt de la granota', desc: 'Fes un salt d\'unitats amb la granota', icon: '🐸' },
      { id: 'supreme_crown', name: 'Corona del mestre suprem', desc: 'Supera 3 reptes experts del repte final', icon: '👑' }
    ];

    let player = {
      name: "Explorador/a",
      avatar: "🧭",
      xp: 0,
      badges: [],
      stats: {
        game1Correct: 0,
        game2Rounds: 0,
        game3Correct: 0,
        game4Best: 0,
        game5Correct: 0,
        frogJumps: 0
      }
    };

    function loadGameData() {
      try {
        const stored = localStorage.getItem('aventura_mesures_v3');
        if (stored) {
          player = Object.assign(player, JSON.parse(stored));
        }
      } catch (err) {
        console.warn("No s'ha pogut accedir al localStorage", err);
      }
      refreshPlayerUI();
    }

    function saveGameData() {
      try {
        localStorage.setItem('aventura_mesures_v3', JSON.stringify(player));
      } catch (err) {
        console.warn("No s'ha pogut desar al localStorage", err);
      }
    }

    function getCurrentRank(xp) {
      for (let i = RANKS.length - 1; i >= 0; i--) {
        if (xp >= RANKS[i].minXp) return RANKS[i];
      }
      return RANKS[0];
    }

    function addPlayerXp(amount) {
      const oldRank = getCurrentRank(player.xp);
      player.xp += amount;
      refreshPlayerUI();
      evaluateBadges();
      saveGameData();

      const newRank = getCurrentRank(player.xp);
      if (newRank.name !== oldRank.name) {
        NativeAudio.playLevelUp();
        NativeConfetti.launch();
        showModalNotice("🌟 Has pujat de rang!", `Felicitats! Ara ets: ${newRank.name}!`);
      }
    }

    function refreshPlayerUI() {
      document.getElementById('playerName').textContent = player.name;
      document.getElementById('playerAvatar').textContent = player.avatar;
      document.getElementById('playerXpVal').textContent = player.xp;

      const r = getCurrentRank(player.xp);
      document.getElementById('playerRankName').textContent = r.name;

      const span = r.maxXp - r.minXp;
      const progress = Math.min(Math.max(player.xp - r.minXp, 0), span);
      const pct = Math.min((progress / span) * 100, 100);
      document.getElementById('playerXpBar').style.width = `${pct}%`;
    }

    function evaluateBadges() {
      function grant(id) {
        if (!player.badges.includes(id)) {
          player.badges.push(id);
          const b = BADGES.find(item => item.id === id);
          NativeAudio.playLevelUp();
          NativeConfetti.launch();
          showModalNotice(`🏆 Nova medalla: ${b.name}!`, `${b.icon} ${b.desc}`);
        }
      }

      if (player.xp >= 20) grant('first_step');
      if (player.stats.game1Correct >= 5) grant('length_hawk');
      if (player.stats.game3Correct >= 4) grant('balance_gold');
      if (player.stats.game2Rounds >= 2) grant('water_drop');
      if (player.stats.game4Best >= 4) grant('speed_lightning');
      if (player.stats.frogJumps >= 1) grant('frog_master');
      if (player.stats.game5Correct >= 3) grant('supreme_crown');
    }

    function resetGameProgress() {
      if (confirm("Vols reiniciar els punts d'experiència i medalles a zero?")) {
        player = {
          name: "Explorador/a",
          avatar: "🧭",
          xp: 0,
          badges: [],
          stats: { game1Correct: 0, game2Rounds: 0, game3Correct: 0, game4Best: 0, game5Correct: 0, frogJumps: 0 }
        };
        saveGameData();
        refreshPlayerUI();
        showModalNotice("Reiniciat", "S'han restablert els punts i el teu progrés.");
      }
    }

    /* -------------------------------------------------------------
       4. LABORATORI DIDÀCTIC: EXPLICACIONS I ESCALA DE LA GRANOTA
    ------------------------------------------------------------- */
    const LAB_DATA = {
      longitud: {
        title: "Unitats de longitud (distància i mida)",
        units: [
          { sym: "mm", name: "mil·límetre", equiv: "1 mm = 0,001 m", obj: "El gruix d'una moneda d'1 euro 🪙 o una petita formiga.", detail: "S'utilitza per a objectes molt fins i detalls diminuts." },
          { sym: "cm", name: "centímetre", equiv: "1 cm = 10 mm", obj: "L'amplada d'un dit de la mà o el clip d'un full 📎.", detail: "Un regle escolar clàssic de la motxilla fa 20 o 30 cm." },
          { sym: "m", name: "metre (unitat principal)", equiv: "1 m = 100 cm = 1.000 mm", obj: "L'alçada d'una porta escolar o la pissarra de classe.", detail: "Si obres els dos braços de bat a bat, és aproximadament 1 metre!" },
          { sym: "km", name: "quilòmetre", equiv: "1 km = 1.000 m", obj: "Una caminada llarga pel barri o la distància al poble veí 🚌.", detail: "Caminant a bon pas es triga uns 12 a 15 minuts en fer 1 km." }
        ],
        frogUnits: ['mm', 'cm', 'm', 'km'],
        rates: { mm: 0.001, cm: 0.01, m: 1, km: 1000 }
      },
      massa: {
        title: "Unitats de massa (el pes dels cossos)",
        units: [
          { sym: "g", name: "gram", equiv: "1 g = 0,001 kg", obj: "Un clip de paper 📎, un caramel 🍬 o una llavor.", detail: "Ideal per a objectes molt lleugers que no fan cap esforç a la mà." },
          { sym: "kg", name: "quilogram (quilo)", equiv: "1 kg = 1.000 g", obj: "Un paquet sencer de farina o d'arròs 🌾.", detail: "La motxilla amb llibres acostuma a pesar entre 3 i 4 kg." }
        ],
        frogUnits: ['g', 'kg'],
        rates: { g: 0.001, kg: 1 }
      },
      capacitat: {
        title: "Unitats de capacitat (líquids i volums)",
        units: [
          { sym: "ml", name: "mil·lilitre", equiv: "1 ml = 0,001 l", obj: "El tap petit d'un medicament o una cullereta de xarop 🥄.", detail: "Usat per a dosis molt petites de líquid en medicina i ciència." },
          { sym: "cl", name: "centilitre", equiv: "1 cl = 10 ml | 100 cl = 1 l", obj: "Una llauna clàssica de refresc (33 cl) o un got ple d'aigua 🥤.", detail: "Molt utilitzat a envasos individuals de sucs i begudes." },
          { sym: "l", name: "litre (unitat principal)", equiv: "1 l = 100 cl = 1.000 ml", obj: "Un tetrabric gran de llet o una ampolla d'aigua 🥛.", detail: "Una ampolla gran d'aigua mineral habitualment conté 1,5 litres." }
        ],
        frogUnits: ['ml', 'cl', 'l'],
        rates: { ml: 0.001, cl: 0.01, l: 1 }
      }
    };

    let activeLabKey = 'longitud';

    function setLabTab(key) {
      activeLabKey = key;
      ['longitud', 'massa', 'capacitat'].forEach(k => {
        const btn = document.getElementById(`btn-mag-${k}`);
        if (k === key) {
          btn.className = "px-4 sm:px-6 py-2.5 rounded-2xl font-black text-sm sm:text-base bg-sky-500 text-white shadow-md transition flex items-center gap-2";
        } else {
          btn.className = "px-4 sm:px-6 py-2.5 rounded-2xl font-black text-sm sm:text-base bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition flex items-center gap-2";
        }
      });
      renderLabCards();
      setupFrogSelectors();
    }

    function renderLabCards() {
      const data = LAB_DATA[activeLabKey];
      const container = document.getElementById('labCardsContainer');
