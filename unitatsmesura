    function calculateFrogJump() {
      NativeAudio.playHop();
      const val = parseFloat(document.getElementById('frogValueInput').value);
      if (isNaN(val)) return;

      const fromU = document.getElementById('frogFromSelect').value;
      const toU = document.getElementById('frogToSelect').value;
      const data = LAB_DATA[activeLabKey];

      const baseVal = val * data.rates[fromU];
      const finalVal = baseVal / data.rates[toU];
      const cleanVal = parseFloat(finalVal.toFixed(6));

      const frogEmoji = document.getElementById('frogAnimEmoji');
      frogEmoji.classList.remove('animate-hop');
      void frogEmoji.offsetWidth;
      frogEmoji.classList.add('animate-hop');

      const box = document.getElementById('frogResultBox');
      box.classList.remove('hidden');

      let explanation = "";
      if (data.rates[fromU] > data.rates[toU]) {
        explanation = "La granota baixa l'escala cap a una unitat més petita: cal multiplicar!";
      } else if (data.rates[fromU] < data.rates[toU]) {
        explanation = "La granota puja l'escala cap a una unitat més gran: cal dividir!";
      } else {
        explanation = "És exactament la mateixa unitat: la quantitat no canvia!";
      }

      document.getElementById('frogResultTitle').textContent = `${val} ${fromU} = ${cleanVal} ${toU}`;
      document.getElementById('frogResultExplanation').textContent = `${explanation} (1 ${fromU} conté ${parseFloat((data.rates[fromU]/data.rates[toU]).toFixed(6))} ${toU})`;

      player.stats.frogJumps++;
      evaluateBadges();
      saveGameData();
    }

